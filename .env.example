# OpenAI API Configuration
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-5

# GPT-5 Specific Configuration
VITE_GPT5_MODEL=gpt-5
VITE_GPT5_REASONING_EFFORT=medium

# Google Gemini AI Configuration
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemma-2-27b-it

# Enhanced AI Configuration
# The AI system automatically routes tasks to the optimal model:
# - GPT-5 FIRST for all tasks (advanced reasoning, creativity, analysis)
# - Gemma models as FALLBACK for research, factual analysis, and structured tasks
# - Intelligent fallback handling for maximum uptime

# Supabase Configuration (REQUIRED for database and file storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side only, for admin operations)
# This key has admin privileges - keep it secure and never expose in client code
SUPABASE_SERVICE_ROLE_KEY=

# Email Service (for AI-generated emails)
VITE_SENDGRID_API_KEY=
VITE_FROM_EMAIL=

# External CRM Integration (optional)
VITE_CRM_API_URL=
VITE_CRM_API_KEY=

# Web Search Integration (optional - for enhanced research)
VITE_WEB_SEARCH_API_KEY=
VITE_WEB_SEARCH_PROVIDER=serpapi

# Environment Configuration
ENVIRONMENT=production

PUBLIC_API_URL=https://api.smartcrm.vip