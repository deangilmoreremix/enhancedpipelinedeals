# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-5

# Google Gemma AI Configuration
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Available Gemma Models (via Gemini API):
# - gemma-2-27b-it (Gemma 2 27B Instruction Tuned - Recommended for complex analysis)
# - gemma-2-9b-it (Gemma 2 9B Instruction Tuned - Recommended for general tasks)
# - gemma-2-2b-it (Gemma 2 2B Instruction Tuned - Fast processing)
VITE_GEMINI_MODEL=gemma-2-27b-it

# Enhanced AI Configuration
# The AI system automatically routes tasks to the optimal model:
# - GPT-5 FIRST for all tasks (advanced reasoning, creativity, analysis)
# - Gemma models as FALLBACK for research, factual analysis, and structured tasks
# - Intelligent fallback handling for maximum uptime

# Supabase Configuration (for database)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service (for AI-generated emails)
VITE_SENDGRID_API_KEY=your_sendgrid_api_key
VITE_FROM_EMAIL=noreply@yourcrm.com

# External CRM Integration (optional)
VITE_CRM_API_URL=your_crm_api_url
VITE_CRM_API_KEY=your_crm_api_key