# Stack: Netlify + Supabase + OpenAI only.

# Supabase (public, safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (set in Netlify > Site settings > Environment variables). NEVER prefix with VITE_ ---
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional model overrides (defaults shown)
OPENAI_MODEL_DEFAULT=gpt-6.1-sol
OPENAI_MODEL_DEEP=gpt-6-astra
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.6-sunburst
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
