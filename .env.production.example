# Production Environment Configuration
# Copy this file and rename to .env.production for production deployment

# Supabase Production Configuration
VITE_SUPABASE_URL=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key-here

# Supabase Service Role Key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key-here

# OpenAI Production Configuration
VITE_OPENAI_API_KEY=your-production-openai-api-key
VITE_OPENAI_MODEL=gpt-5

# Google Gemini Production Configuration
VITE_GEMINI_API_KEY=your-production-gemini-api-key
VITE_GEMINI_MODEL=gemma-2-27b-it

# Calendar Integration (Google OAuth)
VITE_GOOGLE_CALENDAR_CLIENT_ID=your-production-google-calendar-client-id
VITE_GOOGLE_CALENDAR_CLIENT_SECRET=your-production-google-calendar-client-secret

# Outlook Calendar Integration
VITE_OUTLOOK_CLIENT_ID=your-production-outlook-client-id
VITE_OUTLOOK_CLIENT_SECRET=your-production-outlook-client-secret

# Email Service (SendGrid for production)
VITE_SENDGRID_API_KEY=your-production-sendgrid-api-key
VITE_FROM_EMAIL=noreply@yourdomain.com

# External CRM Integration
VITE_CRM_API_URL=your-production-crm-api-url
VITE_CRM_API_KEY=your-production-crm-api-key

# Web Search Integration
VITE_WEB_SEARCH_API_KEY=your-production-web-search-api-key
VITE_WEB_SEARCH_PROVIDER=serpapi

# AgentMail Production Configuration
AGENTMAIL_API_KEY=your-production-agentmail-api-key
PUBLIC_API_URL=https://api.yourdomain.com

# Environment Settings
ENVIRONMENT=production
NODE_ENV=production

# Security Settings
VITE_ENABLE_HTTPS=true
VITE_CSP_ENABLED=true

# Monitoring & Analytics
VITE_SENTRY_DSN=your-production-sentry-dsn
VITE_ANALYTICS_ID=your-production-analytics-id

# Performance Settings
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=network-first