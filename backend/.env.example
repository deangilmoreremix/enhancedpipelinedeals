# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration (Supabase)
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# External Integration API Keys
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:4000/integrations/oauth/callback/hubspot

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/oauth/callback/google_sheets

# Webhook Configuration
WEBHOOK_SECRET_KEY=your-webhook-secret-key
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT=30000

# Feature Flags
ENABLE_GRAPHQL=true
ENABLE_REST_API=true
ENABLE_WEBHOOKS=true
ENABLE_INTEGRATIONS=true
ENABLE_API_DOCUMENTATION=true

# Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true