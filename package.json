{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run generate:sitemap",
    "build:analyze": "vite build --mode analyze",
    "build:production": "NODE_ENV=production vite build --mode production",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "preview:production": "NODE_ENV=production vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite",
    "deploy:check": "npm run type-check && npm run lint && npm run test && npm run build",
    "example:agentmail": "echo 'AgentMail removed - example no longer available'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.77",
    "@hello-pangea/dnd": "^16.5.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@supabase/supabase-js": "^2.39.0",
    "ai": "^5.0.106",
    "focus-trap-react": "^11.0.4",
    "fuse.js": "^7.0.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.344.0",
    "openai": "^5.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "recharts": "^2.8.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^4.3.6",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@originjs/vite-plugin-federation": "^1.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "jscpd": "^4.0.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
